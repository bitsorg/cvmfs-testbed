# .env.s3 — credentials and switches for the direct-to-S3 ingest variant.
#
# Kept separate from .env on purpose: .env holds the credentials the whole
# testbed depends on, and regenerating it rotates every secret. Nothing here is
# needed by the default topology, so this file can be created, edited or
# deleted without touching a working testbed.
#
# Consumed via `env_file:` in docker-compose.yml (minio, minio-init,
# cvmfs-prepub) rather than ${VAR} interpolation — compose only interpolates
# from the default env-file, so values here reach containers, not the YAML.
#
# Copy to .env.s3 and fill in. init.sh creates it with a random password if
# missing.

# ── The switch ───────────────────────────────────────────────────────────────
# `cvmfs_server ingest` turns on direct-to-S3 upload purely on the EXISTENCE of
# /etc/cvmfs/<repo>.s3.conf — cvmfs_server_ingest.sh appends -3 when it is
# there. The prepub entrypoint writes that file only when S3_DIRECT=1, so this
# is what decides. With 0, ingest uploads through the gateway exactly as before.
#
# NOTE: with S3_DIRECT=1 the objects land in MinIO, NOT under repos/<repo>
# where stratum0's Apache serves them, so the test suite is expected to fail
# until the repository's data source is moved to MinIO as well.
S3_DIRECT=0

# ── MinIO ────────────────────────────────────────────────────────────────────
S3_BUCKET=cvmfs
S3_HOST=minio
S3_PORT=9000
S3_REGION=us-east-1
S3_PARALLEL=16

MINIO_ROOT_USER=cvmfs-testbed
MINIO_ROOT_PASSWORD=

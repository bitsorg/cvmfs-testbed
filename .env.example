# ─── Host paths ──────────────────────────────────────────────────────────────
# Root of the testbed data tree; all container state lives here.
TESTBED_ROOT=/srv/cvmfs-testbed

# Directory containing the binaries under test.
# Must contain: cvmfs-prepub  cvmfs_gateway  cvmfs2  cvmfs_talk
SOFTWARE_ROOT=/srv/cvmfs-testbed/software

# Absolute path to your checked-out bits-console source tree.
# The seeder mounts this read-only to build the Pages site and push to Gitea.
BITS_CONSOLE_SRC=/path/to/bits-console

# ─── Repository ──────────────────────────────────────────────────────────────
# CVMFS repository domain.  Must match what cvmfs_server mkfs was given.
REPO_NAME=test.cvmfs.io

# ─── Secrets (populated by init.sh — do not commit .env to version control) ──
CVMFS_GATEWAY_KEY_ID=prepub-key
CVMFS_GATEWAY_SECRET=
PREPUB_API_TOKEN=
PREPUB_HMAC_SECRET=

# ─── Gitea (populated by init.sh) ────────────────────────────────────────────
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_PASSWORD=
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=

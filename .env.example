# ─── Host paths ──────────────────────────────────────────────────────────────
# Root of the testbed data tree; all container state lives here.
# Recommended: $HOME/cvmfs-testbed  (avoid /srv — often read-only on modern distros)
TESTBED_ROOT=

# Directory containing the CVMFS binaries under test.
# Convention: leave blank — defaults to <cvmfs-testbed>/software/ (next to this script),
# which is populated by install.sh.  Override only if you need binaries elsewhere.
SOFTWARE_ROOT=

# ─── Repository ──────────────────────────────────────────────────────────────
# CVMFS repository domain.  Must match what cvmfs_server mkfs was given.
REPO_NAME=test.cvmfs.io

# Which store the repository is SERVED FROM:  s3 | local
#
#   s3     — mkfs -s; the gateway receiver commits catalogs into the bucket and
#            CVMFS_STRATUM0 / CVMFS_SERVER_URL point at MinIO.  This is the
#            production deployment model.  Requires MinIO credentials in .env.s3.
#   local  — repository on local disk, served by the stratum0 Apache.  Retained
#            as the comparison baseline for every measurement taken so far.
#
# NOT the same knob as S3_ENABLED in .env.s3, which says only that MinIO is
# running and the per-job `direct_s3` capability is available.  Enabling
# direct_s3 while STORAGE=local puts data in the bucket and catalogs on disk,
# leaving a repository no single CVMFS_SERVER_URL can serve.
# See docs/storage-topology.md.
STORAGE=s3

# ─── Secrets (populated by init.sh — do not commit .env to version control) ──
CVMFS_GATEWAY_KEY_ID=prepub-key
CVMFS_GATEWAY_SECRET=
PREPUB_API_TOKEN=
PREPUB_HMAC_SECRET=

# ─── Monitoring: runner-sd (http_sd discovery of runner node-exporters) ──────
# runner-sd asks the GitLab Runners API for the current fleet and serves the
# node-exporter targets to vmagent. Leave RUNNER_SD_TOKEN empty to disable
# (serves []; static node-exporter scraping is unaffected).
GITLAB_URL=https://gitlab.cern.ch
# PRIVATE-TOKEN that can list runners AND read their ip_address
# (project Maintainer/Owner, or admin for instance-wide). Keep secret.
RUNNER_SD_TOKEN=
# List a single project's runners (its numeric id); empty => instance /runners/all (admin token).
RUNNER_SD_PROJECT_ID=
# node-exporter port on the runner hosts (default 9100).
NODE_EXPORTER_PORT=9100
# Optional regex to include only matching runner descriptions, e.g. ^bits-
RUNNER_SD_DESC_REGEX=

# ── Sharing the repository spool with a CI runner (optional) ─────────────────
# Local group given write access to /var/spool/cvmfs/<repo> after mkfs.
#
# Needed only for the ADR-0011 "staged" publish path, where the PRODUCER runs
# cvmfs_swissknife directly on this host as the CI runner's user while the
# repository belongs to CVMFS_USER. It writes a per-invocation scratch
# directory and the per-repository prepare lock under the spool; it only reads
# <spool>/rdonly.
#
# Re-applied on every init, deliberately: mkfs recreates the spool from
# scratch, so a chgrp or ACL applied by hand is destroyed by the next re-init
# and the next staged publish fails with EACCES that looks unrelated.
#
# Leave EMPTY unless you are running staged publishes from a runner on this
# host. A group-writable spool lets anyone in that group alter transaction
# state.
SPOOL_SHARED_GROUP=

# ─── Conflict remediation ────────────────────────────────────────────────────
# true lets a publish that fails on an ALREADY PUBLISHED path delete the
# existing subtree and retry the commit once (--replace-on-conflict).
#
# DESTRUCTIVE, and deliberately opt-in: what is destroyed is the published
# subtree at the conflicting path (prior revisions keep their objects until
# GC), and what recreates it is the retried publish of that same job. Between
# the two commits the path does not exist. The deletion happens only after the
# conflict is confirmed against the published catalogs.
#
# Requires a cvmfs_server carrying the mountless fast-delete fix; without it
# the delete is refused with a warning and the job fails cleanly.
#
# Leave false to keep a conflict a terminal error (the default everywhere).
REPLACE_ON_CONFLICT=false

# ── Promote concurrency (staged publish path) ────────────────────────────────
#
# How many server-side S3 copies run at once when a staged job's objects are
# moved from its staging prefix into the CAS. Only the staged path uses it.
#
# The work is latency-bound: each object costs a HEAD plus a COPY, so
# throughput tracks this number almost linearly (measured 720 objects/s at 16;
# the numbers live in MEASUREMENTS.md §26 in the parent workspace, not in this
# repository). But jobs promote concurrently, so requests in flight
# are this x concurrent staged jobs against a 256-per-host keep-alive pool
# shared with the upload path. Overshooting it churns connections into
# TIME_WAIT rather than queueing; that once lost 64 of 170 jobs in 39 s.
#
# Raising this only helps when prepub is the slow half, and on the staged path
# it usually is not: 49% of one measured publish window was prepub idle waiting
# for the producer. Change one value at a time and compare the `workers` and
# `duration` fields of the "promoted objects into the CAS" log line.
#
# Requires a prepub built after the --promote-workers commit; an older binary
# refuses the unknown flag and will not start.
PROMOTE_WORKERS=16
